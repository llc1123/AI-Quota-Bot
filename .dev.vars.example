# 复制为 .dev.vars 后填值；不要提交 .dev.vars。
WECOM_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..."
ADMIN_TOKEN="replace-with-a-long-random-value"
CODEX_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
ZENMUX_MANAGEMENT_KEY="..."
KRILL_JWT="..."
TELEGRAM_BOT_TOKEN="123456789:replace-with-botfather-token"
TELEGRAM_WEBHOOK_SECRET="replace_with_random_letters_numbers_underscores_or_hyphens"
TELEGRAM_ALLOWED_CHAT_IDS="-1001234567890"

