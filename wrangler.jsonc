{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-quota-bot",
  "account_id": "27f84d8803f0f08e457c5a6cc8ee9d3b",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "vars": {
    "TELEGRAM_BOT_USERNAME": "llc_ai_usage_bot",
    "ZENMUX_API_BASE": "https://zenmux.dev",
    "KRILL_API_BASE": "https://www.krill-code.com"
  },
  "triggers": {
    "crons": []
  },
  "kv_namespaces": [
    {
      "binding": "REPORT_STATE",
      "id": "5235a9def8144a42bde4ef8d9c8be5e8"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEX_AUTH",
        "class_name": "CodexAuthState"
      },
      {
        "name": "DETECTION_JOBS",
        "class_name": "DetectionJob"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexAuthState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DetectionJob"]
    }
  ]
}
