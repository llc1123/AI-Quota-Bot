{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-quota-bot",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEX_AUTH",
        "class_name": "CodexAuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexAuthState"]
    }
  ]
}
