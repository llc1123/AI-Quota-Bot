{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-quota-bot",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "vars": {
    "TELEGRAM_BOT_USERNAME": "llc_ai_usage_bot",
    "ZENMUX_API_BASE": "https://zenmux.dev",
    "KRILL_API_BASE": "https://www.krill-code.com"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "REPORT_STATE",
      "id": "53154e55098a41008c8ca69353d42e01"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEX_AUTH",
        "class_name": "CodexAuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexAuthState"]
    }
  ]
}
